NODE_ENV=development
LOG_LEVEL=info

# Core database (used by Prisma, API, web server-side data layer)
DATABASE_URL=postgresql://dealos:dealos@localhost:5432/dealos?schema=public

# API
API_PORT=3004
REDIS_URL=redis://localhost:6379

# Admin auth
ADMIN_JWT_SECRET=change-this-to-a-very-long-secret-at-least-32-characters
AUTH_SECRET=change-this-to-a-very-long-auth-secret-at-least-32-characters
ADMIN_EMAIL=admin@dealos.ai
ADMIN_PASSWORD=ChangeThisPassword123!

# Public web + SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# Newsletter (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=DealOS <no-reply@dealos.ai>

# AI provider configuration
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Internal server-to-server API access
API_INTERNAL_URL=http://127.0.0.1:3004
CORS_ORIGINS=http://localhost:3002,http://localhost:3003
# Set these only after choosing HTTPS domains and trusted reverse proxy policy
# ADMIN_ORIGIN=https://admin.your-domain.example
TRUST_PROXY=false
