{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.*", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "@dealos/config#build": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "ADMIN_JWT_SECRET",
        "ADMIN_EMAIL",
        "ADMIN_PASSWORD",
        "API_PORT",
        "REDIS_URL",
        "DATABASE_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "@dealos/utils#test": {
      "dependsOn": ["@dealos/utils#build"],
      "outputs": []
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "ADMIN_JWT_SECRET",
    "ADMIN_EMAIL",
    "ADMIN_PASSWORD",
    "ADMIN_ORIGIN",
    "TRUST_PROXY",
    "API_INTERNAL_URL",
    "API_PORT",
    "REDIS_URL",
    "CORS_ORIGINS",
    "AUTH_SECRET",
    "NEXTAUTH_SECRET",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_GA4_ID",
    "NEXT_PUBLIC_CLARITY_ID",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL"
  ]
}
