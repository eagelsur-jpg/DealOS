[Unit]
Description=DealOS api production
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/DealOS-current/apps/api
ExecStart=/root/.nvm/versions/node/v22.23.2/bin/node /root/DealOS-current/scripts/ops/start-service.mjs api
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
